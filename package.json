{
  "name": "discordgpt",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "description": "Control persistent OpenAI Codex sessions from Discord.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm audit --audit-level=high",
    "smoke": "npm run build && node dist/smoke.js",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
