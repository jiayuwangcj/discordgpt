DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_REQUIRE_MENTION=true

CODEX_PROJECT_DIR=/absolute/path/to/project
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never

# Give every bot instance a distinct state path.
CODEX_DISCORD_STATE_DIR=/absolute/path/to/codex-discord-multibot/.state/project-name
