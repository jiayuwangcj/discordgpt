# Required
DISCORD_BOT_TOKEN=
CODEX_PROJECT_DIR=/absolute/path/to/project
# Optional JSON object of workspace aliases to absolute existing directories.
# Store actual host paths outside the repository, e.g. ~/.config/discordgpt/workspaces.json
CODEX_WORKSPACES_FILE=

# Comma-separated Discord user IDs. Empty means nobody is allowed.
DISCORD_ALLOWED_USER_IDS=

# Optional guild channel IDs. DMs bypass this list; all messages require an allowed user.
DISCORD_ALLOWED_CHANNEL_IDS=

# In servers, require an @mention unless this is false. DMs never require it.
DISCORD_REQUIRE_MENTION=true

# Complete answers only by default; opt in to commentary before tool calls.
DISCORD_PROGRESS_ENABLED=false

# Codex settings
CODEX_BIN=codex
# Set this to share one app-server with a tmux Codex TUI. Leave empty for
# bridge-owned stdio mode. Use localhost unless TLS/auth is configured.
CODEX_APP_SERVER_URL=
# Optional bearer/capability token for an authenticated WebSocket listener.
CODEX_APP_SERVER_TOKEN=
CODEX_MODEL=
CODEX_REASONING_EFFORT=
# YOLO defaults apply to new and resumed/bound Codex threads.
# Set workspace-write or read-only explicitly to restrict an instance.
CODEX_SANDBOX=danger-full-access
CODEX_APPROVAL_POLICY=never

# Runtime state; stores Discord-channel -> Codex-thread and immutable workspace bindings.
CODEX_DISCORD_STATE_DIR=.state

# Optional signed HTTP ingress behind an HTTPS reverse proxy. Leave port empty for Gateway delivery.
DISCORD_INTERACTIONS_PORT=
DISCORD_PUBLIC_KEY=
# Public NEW endpoint, used by upgrade-service.mjs; preserve a distinct old route for passthrough.
DISCORD_INTERACTIONS_URL=
DISCORD_INTERACTIONS_FALLBACK_URL=
